{
  "manifest_version": 3,
  "name": "Rayzan Bridge",
  "version": "0.0.0",
  "description": "Provider-independent browser bridge for local Rayzan",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.z.ai/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Rayzan",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rayzan-bridge@rayzan.local",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8787/*",
        "http://localhost:8787/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.z.ai/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
