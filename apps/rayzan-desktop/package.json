{
  "name": "@rayzan/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "Rayzan desktop application",
  "author": "Rayzan",
  "scripts": {
    "dev": "node scripts/ensure-electron-sqlite.mjs && vite",
    "build": "node scripts/ensure-electron-sqlite.mjs && vite build",
    "dist": "node scripts/ensure-electron-sqlite.mjs && vite build && node scripts/package-desktop.mjs",
    "rebuild-native": "node scripts/ensure-electron-sqlite.mjs --force",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test tests/managed-provider.test.ts tests/derive.test.ts tests/markdown.test.tsx"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "esbuild": "^0.25.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@rayzan/capture": "workspace:*",
    "@rayzan/local": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "32.2.8",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "local.rayzan.desktop",
    "productName": "Rayzan",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      {
        "from": ".electron-native/node_modules/better-sqlite3",
        "to": "node_modules/better-sqlite3",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/esbuild",
        "to": "node_modules/esbuild",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@esbuild",
        "to": "node_modules/@esbuild",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**",
      "node_modules/esbuild/**",
      "node_modules/@esbuild/**"
    ],
    "extraResources": [
      {
        "from": "../rayzan-local/public",
        "to": "local-public"
      },
      {
        "from": "../../packages/capture",
        "to": "capture",
        "filter": [
          "package.json",
          "src/**",
          "!src/**/*.test.ts"
        ]
      },
      {
        "from": "resources/rayzan-app-icon.ico",
        "to": "rayzan-app-icon.ico"
      }
    ],
    "npmRebuild": false,
    "afterPack": "./scripts/after-pack.cjs",
    "electronVersion": "32.2.8",
    "forceCodeSigning": false,
    "nsis": {
      "installerIcon": "resources/rayzan-app-icon.ico",
      "uninstallerIcon": "resources/rayzan-app-icon.ico"
    },
    "win": {
      "icon": "resources/rayzan-app-icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "Rayzan-${version}-win-${arch}.${ext}"
  }
}
