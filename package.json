{
  "name": "rayzan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --filter @rayzan/browser-extension typecheck && pnpm --filter @rayzan/desktop typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @rayzan/protocol --filter @rayzan/events --filter @rayzan/storage --filter @rayzan/transport --filter @rayzan/orchestrator --filter @rayzan/local --filter @rayzan/browser-extension test",
    "build:extension": "pnpm --filter @rayzan/browser-extension build",
    "build:local": "pnpm --filter @rayzan/local build",
    "start:local": "pnpm --filter @rayzan/local start",
    "desktop:dev": "pnpm --filter @rayzan/desktop dev",
    "desktop:build": "pnpm --filter @rayzan/desktop build",
    "desktop:dist": "pnpm --filter @rayzan/desktop dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
